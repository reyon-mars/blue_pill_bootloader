 165:src/system.cpp **** // systick_init()
 166:src/system.cpp **** //
 167:src/system.cpp **** // Must be called AFTER clock_init(). The RELOAD value is computed
 168:src/system.cpp **** // assuming SYSCLK = 48 MHz. If called before clock_init(), each
 169:src/system.cpp **** // "tick" would be 6 ms instead of 1 ms (8 MHz / 48 MHz = 1/6).
 170:src/system.cpp **** //
 171:src/system.cpp **** // SysTick reload formula:
 172:src/system.cpp **** //      RELOAD  = (f_cpu / f_desired_tick) - 1
 173:src/system.cpp **** //      RELOAD  = (48,000,000 / 1,000) - 1
 174:src/system.cpp **** //      RELOAD  = (48,000) - 1
 175:src/system.cpp **** //      RELOAD  = 47,999
 176:src/system.cpp **** //
 177:src/system.cpp **** // The "-1" accounts for the counter's behavior: it counts from
 178:src/system.cpp **** // RELOAD down to 0 inclusive, then fires. That is (RELOAD + 1)
 179:src/system.cpp **** // distinct states = (RELOAD + 1) clock cycles per tick.
 180:src/system.cpp **** // If RELOAD = 47,999: counter visits 47,999 states (47999 to 1)
 181:src/system.cpp **** // plus state 0 = 48,000 clock cycles.
 182:src/system.cpp **** // =================================================================
 183:src/system.cpp **** void systick_init(){
