 118:src/system.cpp ****     // ──────────────────────────────�
 119:src/system.cpp ****     // STEP 4: Poll until PLL is locked.
 120:src/system.cpp ****     //
 121:src/system.cpp ****     // The PLL's feedback loop (phase comparator -> charge pump -> VCO)
 122:src/system.cpp ****     // requires ~200 microseconds to converge from initial acquisition
 123:src/system.cpp ****     // to stable lock at 48 MHz.
 124:src/system.cpp ****     //
 125:src/system.cpp ****     // During these ~200 microseconds, VCO output sweeps from its power-on
 126:src/system.cpp ****     // frequency up toward 48 MHz, it is NOT yet 48 MHz.
 127:src/system.cpp ****     //
 128:src/system.cpp ****     // PLLRDY is a read-only bit set by the hardware when the phase
 129:src/system.cpp ****     // detector confirms feedback equals reference.
 130:src/system.cpp ****     // ──────────────────────────────�
 131:src/system.cpp ****     while( !(RCC->CR & RCC_CR_bits::PLLRDY) ) {}
