 133:src/system.cpp ****     // ──────────────────────────────�
 134:src/system.cpp ****     // STEP 5: Request Clock Switch to PLL.
 135:src/system.cpp ****     //
 136:src/system.cpp ****     // SW[1:0] = 10 selects PLL output as SYSCLK source.
 137:src/system.cpp ****     // The clock MUX responds in the analog clock domain, which takes
 138:src/system.cpp ****     // a few clock cycles after this write.
 139:src/system.cpp ****     //
