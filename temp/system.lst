 101:src/system.cpp ****               | RCC_CFGR_bits::PLLMUL_12
 102:src/system.cpp ****               | RCC_CFGR_bits::USBPRE_DIV1
 103:src/system.cpp ****               | RCC_CFGR_bits::HPRE_DIV1
 104:src/system.cpp ****               | RCC_CFGR_bits::PPRE1_DIV2
 105:src/system.cpp ****               | RCC_CFGR_bits::PPRE2_DIV1;
 106:src/system.cpp ****               
 107:src/system.cpp ****     // ──────────────────────────────�
 108:src/system.cpp ****     // STEP 3: Enable the PLL.
 109:src/system.cpp ****     //
 110:src/system.cpp ****     // We need to use |= here, instead of a full assignment because
 111:src/system.cpp ****     // the HSION (bit 0) controls the HSI oscillator. If we wrote
 112:src/system.cpp ****     // a full assignment with HSION = 0, we would turn off HSI, which
 113:src/system.cpp ****     // is the clock source we are CURRENTLY RUNNING FROM, before the
 114:src/system.cpp ****     // PLL is locked. The chip would lose its clock entirely.
 115:src/system.cpp ****     // ──────────────────────────────�
 116:src/system.cpp ****     RCC->CR |= RCC_CR_bits::PLLON;
