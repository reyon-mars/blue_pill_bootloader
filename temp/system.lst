  45:src/system.cpp **** // clock_init()
  46:src/system.cpp **** //
  47:src/system.cpp **** // Configures SYSCLK = 48 MHz from HSI via PLL.
  48:src/system.cpp **** //
  49:src/system.cpp **** // Starting state (guaranteed by hardware reset):
  50:src/system.cpp **** //      -> SYSCLK = HSI = 8 MHz
  51:src/system.cpp **** //      -> PLL = OFF
  52:src/system.cpp **** //      -> AHB/APB prescalers = /1
  53:src/system.cpp **** //      -> FLASH wait states  = 0
  54:src/system.cpp **** //      -> All Peripheral Clocks = OFF (except RCC, SRAM, FLASH)
  55:src/system.cpp **** // =================================================================
  56:src/system.cpp **** void clock_init(){
  96              		.loc 1 56 18 is_stmt 1 view -0
  97              		.cfi_startproc
  98              		@ args = 0, pretend = 0, frame = 0
  99              		@ frame_needed = 0, uses_anonymous_args = 0
 100              		@ link register save eliminated.
  57:src/system.cpp ****     
  58:src/system.cpp ****     // ──────────────────────────────�
  59:src/system.cpp ****     // STEP 1: FLASH wait states MUST come before any Clock increase.
  60:src/system.cpp ****     //
  61:src/system.cpp ****     // Currently at 8 MHz: 0 wait states are correct.
  62:src/system.cpp ****     // After switch to 48 MHz: 1 wait state required.
  63:src/system.cpp ****     // We need to configure wait states at 8 MHz, because this write
  64:src/system.cpp ****     // itself requires 0 wait states to execute correctly and is in 
  65:src/system.cpp ****     // place before the frequency rises.
  66:src/system.cpp ****     //
  67:src/system.cpp ****     // If we raised frequency first then set wait states:
  68:src/system.cpp ****     //  -> The fetch of THIS very instruction would be corrupted.
  69:src/system.cpp ****     //  -> We would likely never reach the wait state configuration.
  70:src/system.cpp ****     //
  71:src/system.cpp ****     // ACR_PRFTBE: enable 2-word (64 Bytes) prefetch buffer. Speculatively 
  72:src/system.cpp ****     // reads next word while CPU executes current instruction. Recovers most 
  73:src/system.cpp ****     // of the wait state throughput penalty for sequential code.
  74:src/system.cpp ****     // ──────────────────────────────�
  75:src/system.cpp ****     FLASH->ACR  =   FLASH_bits::ACR_LATENCY_1WS | FLASH_bits::ACR_PRFTBE;
 101              		.loc 1 75 5 view .LVU14
 102              		.loc 1 75 17 is_stmt 0 view .LVU15
 103 0000 0D4B     		ldr	r3, .L11
 104 0002 1122     		movs	r2, #17
 105 0004 1A60     		str	r2, [r3]
  76:src/system.cpp ****     
  77:src/system.cpp ****     // ──────────────────────────────�
  78:src/system.cpp ****     // STEP 2: Configure CFGR before enabling PLL.
  79:src/system.cpp ****     // 
  80:src/system.cpp ****     // RM0008 Section 7.3.2 states explicitly:
  81:src/system.cpp ****     //      "PLLSRC and PLLMUL bits can be written only when PLL is 
  82:src/system.cpp ****     //       disabled (PLLON = 0)."
  83:src/system.cpp ****     //      "The reset state of RCC_CFGR is also guaranteed to be 0x00000000
  84:src/system.cpp ****     //       (all set to zeroes)."
  85:src/system.cpp ****     //
  86:src/system.cpp ****     // Configuration rationale:
  87:src/system.cpp ****     //  PLLSRC_HSI_DIV2: PLL input = 8 MHz / 2 = 4 MHz.
  88:src/system.cpp ****     //      (HSE is not populated on most Blue Pill; must use HSI/2.)
  89:src/system.cpp ****     //      The /2 is fixed in hardware, HSI cannot feed PLL directly.
  90:src/system.cpp ****     //  PLLMUL_12: 4 MHz x 12 = 48 MHz PLL output.
  91:src/system.cpp ****     //  USBPRE_DIV1: USB clock = PLL / 1 = 48 MHz.
  92:src/system.cpp ****     //      (Use DIV1.5 only when PLL = 72 MHz: 72/1.5 = 48 MHz.)  
  93:src/system.cpp ****     //  HPRE_DIV1: HCLK = SYSCLK = 48 MHz.
  94:src/system.cpp ****     //  PPRE1_DIV2: APB1 = HCLK / 2 = 24 MHz.
  95:src/system.cpp ****     //      REQUIRED: RM0008 specifies APB1 maximum = 36 MHz.
  96:src/system.cpp ****     //      Exceeding this violates timing specs of I2C, SPI2, etc.
  97:src/system.cpp ****     //      24 MHz gives comfortable margin below the 36 MHz limit.
  98:src/system.cpp ****     //  PPRE2_DIV1: APB2 = HCLK = 48 MHz. GPIO, SPI1, USART1 are here.  
  99:src/system.cpp ****     // ──────────────────────────────�
 100:src/system.cpp ****     RCC->CFGR = RCC_CFGR_bits::PLLSRC_HSI_DIV2
